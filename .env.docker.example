# Salin menjadi .env.docker lalu ganti seluruh password sebelum deployment.
POSTGRES_DB=matrikulasi
POSTGRES_USER=matrikulasi
POSTGRES_PASSWORD=ganti-dengan-password-kuat
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# Neo4j Community hanya memakai database default `neo4j`.
NEO4J_PASSWORD=ganti-dengan-password-kuat
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_DATABASE=neo4j
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m
