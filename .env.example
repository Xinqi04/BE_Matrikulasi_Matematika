# Salin file ini jadi .env dan isi dengan value asli. Jangan commit .env.

# Gemini API (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# YouTube Data API v3 (Google Cloud Console)
YOUTUBE_API_KEY=

# Neo4j lokal
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=matrikulasi

# Identitas modul default (harus konsisten dengan data yang sudah ada di KG)
DEFAULT_MODUL_ID=modul_matrikulasi_matematika_dasar
DEFAULT_NAMA_DOMAIN=Matematika Dasar

# Parameter chunking / ekstraksi
MAX_CHARS_PER_CHUNK=5100
MAKS_KONSEP_PER_CHUNK=5

UPLOAD_DIR=uploads

# Auth (JWT) -- generate value acak yang panjang, jangan pakai default di production
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440
